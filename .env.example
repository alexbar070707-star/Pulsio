# Copy this to .env and fill in your values
# NEVER commit .env to GitHub

# PostgreSQL — get this from Railway after adding a Postgres service
DATABASE_URL=postgresql+asyncpg://user:password@host:port/pulsio

# Redis — get this from Railway after adding a Redis service
REDIS_URL=redis://localhost:6379

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Anthropic — your API key for the quality gate judge
ANTHROPIC_API_KEY=sk-ant-...
